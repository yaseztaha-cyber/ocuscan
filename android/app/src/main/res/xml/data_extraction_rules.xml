<?xml version="1.0" encoding="utf-8"?>
<!-- No auto backup, no device transfer: health measurements, profiles,
     and research captures never leave the device via backup channels.
     allowBackup=false in the manifest is the primary switch; this file
     closes the device-transfer path (Android 12+). -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="false">
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" path="research_captures" />
        <exclude domain="file" path="research_exports" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" path="research_captures" />
        <exclude domain="file" path="research_exports" />
    </device-transfer>
</data-extraction-rules>
